DB_USER=
DB_PASSWORD=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
APP_PROFILE=prod
DB_VENDOR=postgres
DB_NAME=openprotege
DB_IMAGE=postgres:17-alpine
SERVER_PORT=8080
DB_PORT=5432
DB_CONTAINER_PORT=5432
DB_VOLUME=postgres_data
DB_DATA_PATH=/var/lib/postgresql/data
# To switch to MySQL, set DB_VENDOR=mysql, DB_IMAGE=mysql:8.4, DB_PORT=3306,
# DB_CONTAINER_PORT=3306, DB_VOLUME=mysql_data and DB_DATA_PATH=/var/lib/mysql.
# Set this to a separate strong secret when using MySQL.
MYSQL_ROOT_PASSWORD=

# Optional OpenAI-compatible AI provider configuration. Keep the API key server-side.
# OPENPROTEGE_AI_ENABLED=true
# OPENPROTEGE_AI_PROVIDER=deepseek
# OPENPROTEGE_AI_BASE_URL=https://api.deepseek.com/v1
# OPENPROTEGE_AI_MODEL=deepseek-chat
# OPENPROTEGE_AI_API_KEY=
